# School ERP - Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Example: mongodb://localhost:27017/little_flower_school
MONGO_URI=your_mongodb_uri_here

# Security
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRE=30d

# File Storage
UPLOAD_PATH=uploads

# Deployed Domain Configuration (Optional in local, required in production)
# BACKEND_URL=https://api.lfessiwan.in
# ALLOWED_ORIGINS=https://erp.lfessiwan.in

# Security & Performance Tuning
# RATE_LIMIT_MAX=100
